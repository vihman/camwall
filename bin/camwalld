#!/usr/bin/python3
"""camwalld - control daemon for the camwall camera wall (systemd Type=notify).

Runs the wall as a child process while a display answers the presence probe, and
stops it while the monitor has no power. No video passes through this process.

  WALL=planes     /usr/local/bin/camwall-planes: hardware decode straight onto
                  display planes (default)
  WALL=gstreamer  /usr/local/bin/camwall: the ffmpeg + GStreamer wall (fallback)

Configuration comes from the environment (systemd EnvironmentFile):
  CAM1_URL..CAM4_URL           required: rtsp:// or rtsps:// URL of each tile's stream.
                               <NAME> in a URL is replaced with the value of the
                               config variable NAME (e.g. <STREAM_HOST>, <TOKEN1>).
                               The wall gets the expanded URLs in its environment.
  WALL                         planes or gstreamer (default planes)
  DISPLAY_PROBE                command that succeeds while the monitor is powered
                               (default "ddcutil --syslog never getvcp d6"; "none" disables).
                               A probe that cannot run at all (missing, or exit status
                               126/127, e.g. a broken shared library) is logged and the
                               wall runs without display detection.
  PROBE_INTERVAL               seconds between probes (default 5)
  PROBE_FAILS                  consecutive failed probes before the wall stops (default 3)
  PROBE_SETTLE                 seconds to wait after the display returns (default 3)
The GStreamer wall reads its own settings (FPS, TILE_*, STREAM_TIMEOUT) itself.

A configuration error exits with 78 (EX_CONFIG), which the unit does not restart on.
A wall that exits is restarted here with backoff; a wall that exits with 78 makes
this daemon exit with 78 too.

  camwalld --url N|-   read /etc/camwall/camwall.conf, print camera N's expanded URL
                       (or that of a template read from stdin) and exit; used by the
                       tools in tools/
"""

import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time

EX_CONFIG = 78
BIN_DIR = os.environ.get("CAMWALL_BIN_DIR", "/usr/local/bin")   # override for testing
WALLS = {"planes": "camwall-planes", "gstreamer": "camwall"}
BACKOFF = (2, 4, 8, 16, 30)   # seconds before restarting a wall that exited
HEALTHY = 60                  # a wall that ran this long resets the backoff
STOP_GRACE = 10               # seconds between SIGTERM and SIGKILL


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def config_error(msg):
    log(f"camwalld: {msg}")
    sys.exit(EX_CONFIG)


def int_in(name, default, lo, hi):
    """A whole number from the environment, within [lo, hi]."""
    raw = os.environ.get(name, "") or str(default)
    if not raw.isdigit() or not lo <= int(raw) <= hi:
        config_error(f"{name} must be a whole number from {lo} to {hi} (got '{raw}')")
    return int(raw)


def notify(msg):
    """sd_notify(3) without libsystemd: one datagram to $NOTIFY_SOCKET."""
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM | socket.SOCK_CLOEXEC) as s:
            s.connect(addr)
            s.sendall(msg.encode())
    except OSError as e:
        log(f"sd_notify failed: {e}")


def expand_url(name, template):
    """Replace each <VAR> with the config variable VAR. Errors name the variable,
    never the value (URLs and tokens are credentials)."""
    def var(m):
        value = os.environ.get(m.group(1), "")
        if not value:
            config_error(f"{name} uses <{m.group(1)}>, which is not set")
        return value
    url = re.sub(r"<([A-Za-z_][A-Za-z0-9_]*)>", var, template)
    if not re.match(r"rtsps?://[^/\s]", url) or re.search(r"[<>\s]", url):
        config_error(f"{name} must be an rtsp:// or rtsps:// URL without spaces")
    return url


def camera_urls():
    urls = []
    for i in range(1, 5):
        template = os.environ.get(f"CAM{i}_URL", "")
        if not template:
            config_error(f"CAM{i}_URL is not set (see /etc/camwall/camwall.conf)")
        urls.append(expand_url(f"CAM{i}_URL", template))
    return urls


class Config:
    def __init__(self):
        self.urls = camera_urls()
        self.wall = os.environ.get("WALL", "") or "planes"
        if self.wall not in WALLS:
            config_error(f"WALL must be one of {', '.join(WALLS)} (got '{self.wall}')")
        self.wall_cmd = os.path.join(BIN_DIR, WALLS[self.wall])
        if not os.access(self.wall_cmd, os.X_OK):
            config_error(f"{self.wall_cmd} is missing or not executable (run install.sh)")
        self.interval = int_in("PROBE_INTERVAL", 5, 1, 3600)
        self.fails = int_in("PROBE_FAILS", 3, 1, 100)
        self.settle = int_in("PROBE_SETTLE", 3, 0, 600)
        probe = os.environ.get("DISPLAY_PROBE", "ddcutil --syslog never getvcp d6")
        self.probe = shlex.split(probe) if probe not in ("", "none") else None
        if self.probe and not shutil.which(self.probe[0]):
            log(f"display probe '{self.probe[0]}' not found, running without display detection")
            self.probe = None


class Wall:
    """The wall as a child process in its own process group."""

    def __init__(self, cfg):
        self.cfg = cfg
        self.proc = None
        self.started = 0.0

    def start(self):
        env = dict(os.environ)
        env["DISPLAY_PROBE"] = "none"   # the GStreamer wall must not probe on its own
        for i, url in enumerate(self.cfg.urls, 1):
            env[f"CAM{i}_URL"] = url
        self.proc = subprocess.Popen([self.cfg.wall_cmd], env=env, start_new_session=True,
                                     stdin=subprocess.DEVNULL)
        self.started = time.monotonic()
        log(f"started the {self.cfg.wall} wall (pid {self.proc.pid})")

    def exited(self):
        """Exit status if the wall has exited, else None."""
        return None if self.proc is None else self.proc.poll()

    def uptime(self):
        return time.monotonic() - self.started

    def stop(self):
        if self.proc is None:
            return
        if self.proc.poll() is None:
            self._signal(signal.SIGTERM)
            try:
                self.proc.wait(STOP_GRACE)
            except subprocess.TimeoutExpired:
                log("wall did not stop, killing it")
                self._signal(signal.SIGKILL)
                self.proc.wait()
        self._signal(signal.SIGKILL)   # leftovers in the group, e.g. ffmpeg
        self.proc = None

    def _signal(self, sig):
        try:
            os.killpg(self.proc.pid, sig)
        except ProcessLookupError:
            pass


class Stop(Exception):
    pass


def load_conf(path):
    """KEY=value lines into the environment, as systemd's EnvironmentFile= reads
    them. The file cannot be sourced by a shell: <NAME> would be a redirection."""
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line[0] in "#;" or "=" not in line:
                    continue
                key, value = (s.strip() for s in line.split("=", 1))
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                    value = value[1:-1]
                os.environ[key] = value
    except OSError as e:
        config_error(f"cannot read {path}: {e.strerror}")


def print_url(arg):
    load_conf(os.environ.get("CAMWALL_CONF", "/etc/camwall/camwall.conf"))   # override for testing
    if arg == "-":
        print(expand_url("the URL from stdin", sys.stdin.readline().strip()))
    elif arg in ("1", "2", "3", "4"):
        print(camera_urls()[int(arg) - 1])
    else:
        config_error("usage: camwalld --url N|-")


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--url":
        return print_url(sys.argv[2])
    cfg = Config()

    def on_term(signum, frame):
        raise Stop
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    def display_on():
        """(True|False, reason) for display present or absent, (None, reason) if the
        probe cannot run at all: exit status 126/127 is the shell convention for
        "not executable" / "not found", which also covers a shared-library load error."""
        if cfg.probe is None:
            return True, ""
        try:
            r = subprocess.run(cfg.probe, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, timeout=10)
        except subprocess.TimeoutExpired:
            return False, "probe timed out"
        except OSError as e:
            return None, str(e)
        lines = [l.strip() for l in r.stdout.decode(errors="replace").splitlines() if l.strip()]
        reason = lines[0][:160] if lines else f"exit status {r.returncode}"
        if r.returncode in (126, 127):
            return None, reason
        return r.returncode == 0, reason

    def status(msg):
        notify(f"STATUS={msg}")

    wall = Wall(cfg)
    notify("READY=1")
    log(f"camwalld: {cfg.wall} wall, display probe "
        f"{'off' if cfg.probe is None else repr(shlex.join(cfg.probe))}")

    present = None        # None until the first probe
    fails = 0
    restarts = 0
    restart_at = 0.0      # monotonic time when an exited wall may start again
    next_probe = 0.0
    try:
        while True:
            notify("WATCHDOG=1")
            now = time.monotonic()

            if now >= next_probe:
                next_probe = now + cfg.interval
                on, why = display_on()
                if on is None:
                    log(f"display probe cannot run ({why}), running without display detection")
                    cfg.probe = None
                    on = True
                if on:
                    fails = 0
                    if present is False:
                        log(f"display detected, starting the wall in {cfg.settle}s")
                        restart_at = max(restart_at, time.monotonic() + cfg.settle)   # after the (slow) probe
                    present = True
                else:
                    fails += 1
                    if present is None or (present and fails >= cfg.fails):
                        if wall.proc is not None:
                            log(f"display lost ({fails} failed probes: {why}), stopping the wall")
                            wall.stop()
                        log(f"no display detected ({why}), idle until it returns")
                        status(f"no display, idle ({why})")
                        present = False

            rc = wall.exited()
            if rc is not None:
                if rc == EX_CONFIG:
                    log("the wall reported a configuration error")
                    sys.exit(EX_CONFIG)
                if wall.uptime() >= HEALTHY:
                    restarts = 0
                delay = BACKOFF[min(restarts, len(BACKOFF) - 1)]
                restarts += 1
                log(f"the wall exited (status {rc}), restarting in {delay}s")
                status(f"wall exited (status {rc}), restarting in {delay}s")
                wall.stop()   # clears leftovers in its process group
                restart_at = time.monotonic() + delay

            if present and wall.proc is None and time.monotonic() >= restart_at:
                wall.start()
                status(f"{cfg.wall} wall running")

            time.sleep(1)
    except Stop:
        notify("STOPPING=1")
        wall.stop()


if __name__ == "__main__":
    main()
