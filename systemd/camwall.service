[Unit]
Description=Camera wall (2x2 UniFi Protect on KMS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=camwall
SupplementaryGroups=video render i2c
StateDirectory=camwall
RuntimeDirectory=camwall
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/camwall
EnvironmentFile=/etc/camwall/camwall.conf
ExecStart=/usr/local/bin/camwall
Restart=always
RestartSec=3
RestartSteps=4
RestartMaxDelaySec=60
RestartPreventExitStatus=78
TimeoutStopSec=15

# Hardening. Device access (DRM, V4L2, DMA heaps, i2c) is deliberately not
# restricted yet; see TODO.md.
NoNewPrivileges=yes
CapabilityBoundingSet=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
