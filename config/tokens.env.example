# Installed as /etc/camwall/tokens.env (root:root, mode 0600). NEVER commit the real file.
# systemd reads it as root and passes the variables to the service.

# Gateway name or IP that serves RTSPS on port 7441
UNIFI_HOST=unifi.example.com

# Medium-resolution (1280x720) RTSPS tokens: the last path segment, without ?enableSrtp
#   rtsps://<gateway>:7441/<TOKEN>?enableSrtp
# Order = tile position: 1 top-left, 2 top-right, 3 bottom-left, 4 bottom-right
TOKEN1=replace-me
TOKEN2=replace-me
TOKEN3=replace-me
TOKEN4=replace-me

# Optional output frame rate per tile, a whole number from 1 to 100 (default 15)
#FPS=15

# Optional display presence check. The wall runs only while this command succeeds
# (a monitor without power makes it fail) and idles with no decoding otherwise.
# "none" disables the check. Needs the i2c-dev module and the camwall user in group i2c.
#DISPLAY_PROBE=ddcutil getvcp d6
# Seconds between checks while the wall runs
#PROBE_INTERVAL=5
# Consecutive failed checks before the wall stops
#PROBE_FAILS=3
# Seconds to wait after the display returns before starting the wall
#PROBE_SETTLE=3
