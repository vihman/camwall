# Installed as /etc/camwall/tokens.env (root:root, mode 0600). NEVER commit the real file.
# systemd reads it as root and passes the variables to the service.

# Gateway name or IP that serves RTSPS on port 7441
UNIFI_HOST=unifi.example.com

# Medium-resolution (1280x720) RTSPS tokens: the last path segment of the URL
#   rtsps://<gateway>:7441/<TOKEN>?enableSrtp
# Order = tile position: 1 top-left, 2 top-right, 3 bottom-left, 4 bottom-right
TOKEN1=replace-me
TOKEN2=replace-me
TOKEN3=replace-me
TOKEN4=replace-me
