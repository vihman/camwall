# Installed as /etc/camwall/camwall.conf (root:root, mode 0600). NEVER commit the real file.
# systemd reads it as root (EnvironmentFile=) and passes the variables to the service.
# Format: KEY=value, one per line, no quotes needed, comments only on their own lines.
# Everything below the required part is optional; the commented-out values are the defaults.

# --- Required -----------------------------------------------------------------

# One rtsp:// or rtsps:// URL per tile, H.265 or H.264.
# Order = tile position: 1 top-left, 2 top-right, 3 bottom-left, 4 bottom-right
# <NAME> in a URL is replaced with the value of the variable NAME from this file,
# so a shared host, port or password is written once. Any variable name works.
# Treat this file as a secret: URLs often contain tokens or passwords.
STREAM_HOST=camera.example.com
STREAM_PORT=554
CAM1_URL=rtsp://<STREAM_HOST>:<STREAM_PORT>/stream1
CAM2_URL=rtsp://<STREAM_HOST>:<STREAM_PORT>/stream2
CAM3_URL=rtsp://<STREAM_HOST>:<STREAM_PORT>/stream3
CAM4_URL=rtsps://192.168.1.20:8443/live

# Optional names for MQTT, Home Assistant and the status (default Camera 1..4);
# unique, at most 32 characters
#CAM1_LABEL=Gate
#CAM2_LABEL=Back yard

# Example: UniFi Protect, RTSPS on port 7441 with one token per stream (the last
# path segment of the URL Protect shows, without ?enableSrtp)
#STREAM_PORT=7441
#TOKEN1=replace-me
#CAM1_URL=rtsps://<STREAM_HOST>:<STREAM_PORT>/<TOKEN1>

# --- Wall ---------------------------------------------------------------------

# planes: hardware decode straight onto the display planes, every camera frame,
#         tiles sized from the display mode (default)
# gstreamer: the older ffmpeg + GStreamer wall, kept as a fallback
#WALL=planes

# --- GStreamer wall only (WALL=gstreamer) -------------------------------------

# Output frame rate per tile, a whole number from 1 to 100
#FPS=15

# Size of one tile in pixels, even numbers from 64 to 3840. The screen is twice as
# wide and twice as tall (2x2 tiles), so the defaults fill a 1920x1080 display. For
# another display mode use half its width and height.
#TILE_WIDTH=960
#TILE_HEIGHT=540

# Seconds without data before ffmpeg gives up on a stalled camera and the wall
# restarts, a whole number from 1 to 300
#STREAM_TIMEOUT=10

# --- Display presence check ---------------------------------------------------
# camwalld runs the wall only while this command succeeds (a monitor without power
# makes it fail) and idles with no decoding otherwise. "none" disables the check.
# Needs the i2c-dev module and the camwall user in group i2c.

#DISPLAY_PROBE=ddcutil --syslog never getvcp d6
# Seconds between checks while the wall runs
#PROBE_INTERVAL=5
# Consecutive failed checks before the wall stops
#PROBE_FAILS=3
# Seconds to wait after the display returns before starting the wall
#PROBE_SETTLE=3

# --- MQTT (optional) ----------------------------------------------------------
# Control and status over any MQTT broker. Off unless MQTT=yes; the other MQTT_*
# settings are then read. Check them with tools/mqtt-test.py.
# Topics: <MQTT_TOPIC>/mode/set (send cameras, camera1..camera4 or off), <MQTT_TOPIC>/mode,
# <MQTT_TOPIC>/status and <MQTT_TOPIC>/availability (retained, plain text).
# <NAME> templates are not expanded here.

#MQTT=no
#MQTT_HOST=broker.example.com
# 1883, or 8883 with MQTT_TLS=yes
#MQTT_PORT=1883
#MQTT_USER=camwall
#MQTT_PASSWORD=
# yes: TLS, verifying the broker certificate against the system CAs or MQTT_CA_FILE
# (which the camwall user must be able to read)
#MQTT_TLS=no
#MQTT_CA_FILE=/etc/camwall/mqtt-ca.crt
# Topic prefix; give each wall its own when there is more than one
#MQTT_TOPIC=camwall
#MQTT_CLIENT_ID=camwall-<hostname>
# Home Assistant discovery prefix; none disables discovery
#MQTT_DISCOVERY=homeassistant
